# ── Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables ──

# Session signing key (32+ random chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Cloudflare D1 (HTTP API). Leave empty locally to use the SQLite file in .data/
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
# API token with "Account → D1 → Edit" permission
CF_API_TOKEN=

# ImageKit (Dashboard → Developer options → API keys)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_FOLDER=/ieee-its

# First admin account (used by `npm run db:setup` when no admin exists yet)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SMTP overrides (otherwise configured in /admin → Email & SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
