# ── Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables ──

# Session signing key (32+ random chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Cloudflare D1 via the gateway Worker (workers/d1-gateway) — recommended, no API token needed.
# URL is printed by `npx wrangler deploy`; secret must match `npx wrangler secret put GATEWAY_SECRET`.
D1_GATEWAY_URL=
D1_GATEWAY_SECRET=

# …or Cloudflare D1 via the HTTP API. Leave all D1 settings empty locally to use the SQLite file in .data/
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
# API token with "Account → D1 → Edit" permission
CF_API_TOKEN=

# ImageKit (Dashboard → Developer options → API keys)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_FOLDER=/ieee-its

# First admin account (used by `npm run db:setup` when no admin exists yet)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SMTP overrides (otherwise configured in /admin → Email & SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Optional overrides for the separate account-email SMTP (password-reset codes and links).
# Normally configured in /admin → Email & SMTP → Account emails SMTP; empty = use the main SMTP.
# SMTP_AUTH_HOST=smtp.gmail.com
# SMTP_AUTH_PORT=587
# SMTP_AUTH_SECURE=false
# SMTP_AUTH_USER=
# SMTP_AUTH_PASS=

# Lets the daily Vercel cron (vercel.json) continue large email mail-outs. Any long random string.
CRON_SECRET=
