{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": { "maxDuration": 20, "includeFiles": "server/schema.sql" }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api?__path=sitemap.xml" },
    { "source": "/robots.txt", "destination": "/api?__path=robots.txt" },
    { "source": "/api/:path*", "destination": "/api?__path=:path*" },
    { "source": "/((?!api/|assets/|.*\\.[a-zA-Z0-9]{2,5}$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
